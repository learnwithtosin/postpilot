# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini model id, e.g. gemini-3.8-flash
GEMINI_MODEL=your-gemini-model-id
# Optional: tried once if GEMINI_MODEL is still busy after 3 retries. Leave blank to skip.
GEMINI_FALLBACK_MODEL=
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Set automatically when you first send /start to the bot. Leave blank.
OWNER_CHAT_ID=
# Daily check-in time (24h, Africa/Lagos time) and the date of Day 1 of the 30-day sprint
CHECKIN_TIME=09:00
SPRINT_START=2026-11-21
